# ==============================================================================
# MobileHubBD ERP / E-Commerce Backend (NestJS) — Production Environment Config
# Target: Single VPS (Ubuntu 22.04/24.04), NestJS server on port 4000 behind Nginx
# ==============================================================================

# [OPTIONAL] Listening port for NestJS HTTP server (default: 4000)
PORT=4000

# [REQUIRED] Node runtime environment (enforces security guards, production cors, strict errors)
NODE_ENV=production

# [REQUIRED] PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL=postgresql://novamobile_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/novamobile?schema=public

# [REQUIRED] Cryptographic JWT Authentication Secrets (MANDATORY: Minimum 32 characters each)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_ACCESS_SECRET_KEY
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_REFRESH_SECRET_KEY

# [OPTIONAL] Customer JWT Token Expiry (default: 15m)
JWT_ACCESS_EXPIRY=15m

# [OPTIONAL] Staff Working Shift JWT Token Expiry (default: 8h)
STAFF_JWT_ACCESS_EXPIRY=8h

# [OPTIONAL] Refresh Token Expiry (default: 7d)
JWT_REFRESH_EXPIRY=7d

# [REQUIRED] Permitted CORS Origins (comma-separated, without trailing slash)
ALLOWED_ORIGINS=https://mobilehubbd.tech,https://www.mobilehubbd.tech

# [REQUIRED] Primary Frontend Storefront URL
FRONTEND_URL=https://mobilehubbd.tech

# [REQUIRED] Public API Gateway URL including /api/v1 prefix (used for payment IPN callback URLs)
API_URL=https://api.mobilehubbd.tech/api/v1

# [OPTIONAL] Internal Server-to-Server Frontend URL for local Puppeteer receipt rendering (default: http://localhost:3000)
INTERNAL_FRONTEND_URL=http://localhost:3000

# [REQUIRED] On-Demand ISR Revalidation Secret (MUST match frontend REVALIDATION_SECRET)
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY

# [REQUIRED] Local Persistent Directory for Public Static Uploads (/uploads/...)
# Directory must exist and be writable by Node.js process: chown -R www-data:www-data /var/www/novamobile/uploads
UPLOAD_ROOT=/var/www/novamobile/uploads

# [REQUIRED] Local Persistent Directory for Confidential Private Uploads (staff IDs, expenses, supplier bills)
# Directory must exist and be writable by Node.js process: chown -R www-data:www-data /var/www/novamobile/private-uploads
PRIVATE_UPLOAD_ROOT=/var/www/novamobile/private-uploads

# [REQUIRED] Production Bootstrap Super Admin Configuration (for "npm run bootstrap:prod")
SEED_ADMIN_EMAIL=admin@mobilehubbd.tech
SEED_ADMIN_PASSWORD=REPLACE_WITH_MINIMUM_14_CHAR_STRONG_SUPERADMIN_PASSWORD

# [OPTIONAL] Initial Super Admin Display Name (default: Super Admin)
SEED_ADMIN_NAME=Super Admin

# [OPTIONAL] Chromium executable paths for Headless POS Receipt PDF Generation
# Install on Ubuntu VPS via: sudo apt-get install -y chromium-browser (or chromium)
CHROME_BIN=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# [OPTIONAL] Cloudflare R2 / S3 Object Storage (Leave blank to use local UPLOAD_ROOT)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# [OPTIONAL] SSLCommerz Payment Gateway (Leave credentials blank and IS_LIVE=false for launch)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_LIVE=false

# [OPTIONAL] bKash Direct Checkout (Leave credentials blank and IS_LIVE=false for launch)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_LIVE=false
