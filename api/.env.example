# ==============================================================================
# MobileHubBD API - Production & Local Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Database (Neon / Supabase / Self-Hosted PostgreSQL)
# For Neon/Supabase, use the pooled connection string (with ?pgbouncer=true / -pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# Optional: direct URL for running migrations outside connection poolers
# DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# JWT Authentication (MANDATORY: 32+ characters in production, never use default values)
JWT_ACCESS_SECRET="generate-a-secure-random-64-character-secret-key-here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="generate-a-secondary-secure-random-64-character-secret-key-here"
JWT_REFRESH_EXPIRY="7d"

# CORS & Domain Configuration
# Comma-separated list of permitted frontend origins (Render, Vercel, Custom Domains)
ALLOWED_ORIGINS="https://mobilehubbd.vercel.app,https://*.vercel.app,http://localhost:3000"
FRONTEND_URL="https://mobilehubbd.vercel.app"
API_URL="https://mobilehubbd-api.onrender.com/api/v1"
REVALIDATION_SECRET="generate-a-secure-revalidation-secret-token"

# Object Storage (Cloudflare R2 - S3 Compatible)
# When provided, all file uploads stream directly to Cloudflare R2 and return public CDN URLs.
# If omitted or left empty, the API falls back to local disk storage in UPLOAD_ROOT.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mobilehubbd-media"
# R2_PUBLIC_URL: Custom domain or r2.dev public bucket URL (e.g. https://cdn.mobilehubbd.com or pub-xxx.r2.dev)
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# Local Disk Storage Fallback (used when R2 credentials are not set)
UPLOAD_ROOT="/tmp/uploads"

# 3rd Party Payment Gateways (Optional / Sandbox for Demo)
# SSLCommerz
SSLCOMMERZ_STORE_ID="mobilehubbd_sandbox"
SSLCOMMERZ_STORE_PASS="mobilehubbd_pass"
SSLCOMMERZ_IS_LIVE=false

# bKash
BKASH_APP_KEY="bkash_test_app_key"
BKASH_APP_SECRET="bkash_test_app_secret"
BKASH_USERNAME="bkash_test_user"
BKASH_PASSWORD="bkash_test_pass"
BKASH_IS_LIVE=false

# Database Seed Configuration (Production Super Admin & Demo Toggle)
# In production, SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD are required when seeding.
SEED_ADMIN_EMAIL="admin@mobilehubbd.com"
SEED_ADMIN_PASSWORD="a-very-strong-production-admin-password"
# Set to false to prevent seeding demo staff accounts in staging/production
SEED_DEMO=false

