model PaymentAttempt {
  id          String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway     PaymentGatewayName
  gatewayRef  String?
  status      String
  rawResponse Json?
  createdAt   DateTime           @default(now())
}

enum ProductRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ProductRequest {
  id                   String               @id @default(cuid())
  requestNumber        String               @unique
  requestingBranchId   String
  requestingBranch     Branch               @relation("RequestingBranchRequests", fields: [requestingBranchId], references: [id])
  fulfillingBranchId   String
  fulfillingBranch     Branch               @relation("FulfillingBranchRequests", fields: [fulfillingBranchId], references: [id])
  status               ProductRequestStatus @default(PENDING)
  requestedByUserId    String
  requestedByUser      Staff                @relation("RequestedByUserRequests", fields: [requestedByUserId], references: [id])
  updatedByUserId      String?
  updatedByUser        Staff?               @relation("UpdatedByUserRequests", fields: [updatedByUserId], references: [id])
  approvedByUserId     String?
  approvedByUser       Staff?               @relation("ApprovedByUserRequests", fields: [approvedByUserId], references: [id])
  approvalDate         DateTime?
  note                 String?
  decisionNote         String?
  items                ProductRequestItem[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([requestingBranchId])
  @@index([fulfillingBranchId])
  @@index([status])
}

model ProductRequestItem {
  id               String          @id @default(cuid())
  productRequestId String
  productRequest   ProductRequest  @relation(fields: [productRequestId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id])
  requestedQty     Int             @default(1)
  approvedQty      Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([productRequestId])
  @@index([productId])
  @@index([productVariantId])
}

