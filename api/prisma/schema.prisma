generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================= ENUMS =============================

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum PermissionScope {
  GLOBAL
  OWN_BRANCH
  OWN_DATA
}

enum ModuleName {
  DASHBOARD
  SALES
  CUSTOMERS
  ORDERS
  SALES_RETURNS
  EXCHANGES
  CATEGORY
  PRODUCTS
  BRANCH
  STOCK_ADJUSTMENTS
  HRM
  REPORT
  WALLET
  EXPENSE
  SUPPLIERS
  PURCHASE
  PROMOTIONAL_BANNER
  ADS
  PROMO_CODE
  PUSH_NOTIFICATION
  BLOGS
  HELP_REQUESTS
  HELP_NOTES
  BUSINESS_SETTINGS
  CMS
  THIRD_PARTY_CONFIG
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  VIEW_DETAILS
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum StaffPaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_BANKING
}

enum BranchType {
  FLAGSHIP
  OUTLET
  WAREHOUSE
}

enum AddressTag {
  HOME
  OFFICE
  OTHER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum SaleType {
  POS
  COURIER
  DIAGNOSING
  WEBSITE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PARCEL_BOOKED
  DIAGNOSING
  DELIVERED
  RETURNED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  DUE
  REFUNDED
}

enum PhoneUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  EXCHANGED
}

enum OrderPaymentMethod {
  BKASH
  SSLCOMMERZ
  COD
  CASH
  NAGAD
  CARD
  BANK
  SPLIT
  DUE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  ITEM_RECEIVED
  COMPLETED
  REJECTED
}

enum ServiceJobStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum ServiceMaterialSourceType {
  OWN_STOCK
  SUPPLIER
  OTHER
}

enum ShipmentStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  RECOUNT
}

enum PayrollStatus {
  PAID
  PENDING
  PROCESSING
}

enum WalletKind {
  CASH
  BANK
  MOBILE_BANKING
}

enum WalletTxnType {
  DEPOSIT
  WITHDRAWAL
}

enum PurposeCategory {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PAID
  PENDING
}

enum SupplierPaymentTerm {
  COD
  NET_15
  NET_30
  NET_60
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum PromoApplicableTo {
  ALL
  CATEGORY
  PRODUCT
}

enum AdPlacement {
  HOMEPAGE_SIDEBAR
  CATEGORY_PAGE_TOP
  POPUP_ON_LOAD
  FOOTER_STRIP
}

enum PromoAdStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

enum NotificationTarget {
  ALL_CUSTOMERS
  CUSTOMERS_WITH_CART
  SEGMENT
}

enum NotificationStatus {
  SENT
  SCHEDULED
  DRAFT
  FAILED
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

enum MenuType {
  HEADER
  FOOTER_QUICK_LINKS
  FOOTER_SUPPORT
}

enum MenuLinkType {
  CATEGORY
  PRODUCT
  PAGE
  CUSTOM
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  WHATSAPP
  LINKEDIN
}

enum ContactSubmissionStatus {
  NEW
  READ
  REPLIED
}

enum IssueCategory {
  PRODUCT_ISSUE
  ORDER_ISSUE
  PAYMENT_ISSUE
  OTHER
}

enum TicketStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

enum SenderType {
  CUSTOMER
  STAFF
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentGatewayName {
  BKASH
  SSLCOMMERZ
  COD
}

enum MessageChannel {
  SMS
  EMAIL
}

// ============================= AUTH / STAFF / RBAC =============================

model Role {
  id                     String                 @id @default(cuid())
  name                   String                 @unique
  description            String?
  scope                  PermissionScope        @default(OWN_BRANCH)
  isSystem               Boolean                @default(false)
  staff                  Staff[]
  permissions            RolePermission[]
  branchPermissions      RoleBranchPermission[]
  autoAssignedIssueTypes TicketIssueType[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model RolePermission {
  id      String           @id @default(cuid())
  roleId  String
  role    Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  ModuleName
  action  PermissionAction
  allowed Boolean          @default(false)

  @@unique([roleId, module, action])
}

model RoleBranchPermission {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  canAccess Boolean @default(false)

  @@unique([roleId, branchId])
}

model Staff {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  name               String
  email              String               @unique
  phone              String               @unique
  passwordHash       String
  photo              String?
  gender             String?
  dob                DateTime?
  nidNumber          String?
  roleId             String
  role               Role                 @relation(fields: [roleId], references: [id])
  departmentId       String?
  department         Department?          @relation(fields: [departmentId], references: [id])
  branchId           String?
  branch             Branch?              @relation("BranchStaff", fields: [branchId], references: [id])
  employmentType     EmploymentType       @default(FULL_TIME)
  joiningDate        DateTime             @default(now())
  reportingManagerId String?
  reportingManager   Staff?               @relation("StaffReports", fields: [reportingManagerId], references: [id])
  reports            Staff[]              @relation("StaffReports")
  status             StaffStatus          @default(ACTIVE)
  basicSalary        Decimal              @default(0)
  allowances         Json?
  paymentMethod      StaffPaymentMethod?
  bankAccountNo      String?
  address                      String?
  birthCertificateUrl          String?
  bonusLimit                   Decimal              @default(0)
  adminPanelAccess             Boolean              @default(false)
  isTechnician                 Boolean              @default(false)
  commissionRate               Decimal              @default(0)
  profitSharePercentage        Decimal?             @default(0)
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  sendCredentialsEmailOnCreate Boolean              @default(false)
  branchAccess                 StaffBranchAccess[]
  managedBranches              Branch[]             @relation("BranchManager")
  headOfDepartments            Department[]         @relation("DepartmentHead")
  refreshTokens                RefreshToken[]
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  WastedProduct                WastedProduct[]
  Order                        Order[]
  OrderStatusHistory           OrderStatusHistory[]
  ServiceJob                   ServiceJob[]
  StockAdjustment              StockAdjustment[]
  Payroll                      Payroll[]
  recordedWalletTransactions   WalletTransaction[]  @relation("RecordedByStaff")
  staffWalletTransactions      WalletTransaction[]  @relation("StaffWalletTransactions")
  Expense                      Expense[]
  SupplierPayment              SupplierPayment[]
  Blog                         Blog[]
  SupportTicket                SupportTicket[]
  orderNotes                   OrderNote[]
  requestedProductRequests     ProductRequest[]     @relation("RequestedByUserRequests")
  updatedProductRequests       ProductRequest[]     @relation("UpdatedByUserRequests")
  approvedProductRequests      ProductRequest[]     @relation("ApprovedByUserRequests")
}

model StaffBranchAccess {
  id       String @id @default(cuid())
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffId, branchId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// ============================= CUSTOMER =============================

model Customer {
  id              String             @id @default(cuid())
  name            String
  email           String?            @unique
  phone           String             @unique
  passwordHash    String
  photo           String?
  profileImageUrl String?
  source          String?
  walletBalance   Decimal            @default(0)
  emailVerified   Boolean            @default(false)
  phoneVerified   Boolean            @default(false)
  status          StaffStatus        @default(ACTIVE)
  addresses       Address[]
  orders          Order[]
  payments        Payment[]
  activities      CustomerActivity[]
  wishlist        Wishlist[]
  reviews         Review[]
  supportTickets  SupportTicket[]
  refreshTokens   RefreshToken[]
  serviceJobs     ServiceJob[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Address {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  email       String?
  fullAddress String
  label       String?
  tag         AddressTag @default(HOME)
  isDefault   Boolean    @default(false)
  orders      Order[]
  createdAt   DateTime   @default(now())
}

enum CustomerActivityType {
  REGISTERED
  ORDER_PLACED
  PAYMENT_RECEIVED
  ADDRESS_UPDATED
  PROFILE_UPDATED
  PASSWORD_CHANGED
}

model CustomerActivity {
  id          String               @id @default(cuid())
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        CustomerActivityType
  description String
  metadata    Json?
  createdAt   DateTime             @default(now())
}

model Payment {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount         Decimal
  discount       Decimal  @default(0)
  paymentMethod  String
  paymentChannel String?
  note           String?
  createdAt      DateTime @default(now())
}

// ============================= BRANCH / DEPARTMENT =============================

model Branch {
  id                String            @id @default(cuid())
  name              String
  code              String            @unique
  type              BranchType        @default(OUTLET)
  address           String
  city              String
  phone             String
  altPhone          String?
  email             String?
  managerId         String?
  manager           Staff?            @relation("BranchManager", fields: [managerId], references: [id])
  status            StaffStatus       @default(ACTIVE)
  operatingHours    Json?
  openingStockValue Decimal           @default(0)
  taxRegNumber      String?
  showInFooter      Boolean           @default(true)
  isOnlineDefault   Boolean           @default(false)
  staff             Staff[]               @relation("BranchStaff")
  staffBranchAccess StaffBranchAccess[]
  roleBranchPermissions RoleBranchPermission[]
  orders            Order[]
  stockAdjustments  StockAdjustment[]
  wastedProducts    WastedProduct[]
  expenses          Expense[]
  purchaseOrders    PurchaseOrder[]
  walletTypes       WalletType[]
  walletTransactions WalletTransaction[]
  inventory         BranchInventory[]
  phoneUnits        PhoneUnit[]
  requestingProductRequests ProductRequest[] @relation("RequestingBranchRequests")
  fulfillingProductRequests ProductRequest[] @relation("FulfillingBranchRequests")
  serviceJobs       ServiceJob[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Department {
  id     String      @id @default(cuid())
  name   String      @unique
  headId String?
  head   Staff?      @relation("DepartmentHead", fields: [headId], references: [id])
  status StaffStatus @default(ACTIVE)
  staff  Staff[]
}

// ============================= CATALOG =============================

model Category {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  parentId        String?
  parent          Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]  @relation("CategoryTree")
  icon            String?
  image           String?
  altTag          String?
  description     String?
  isGadget        Boolean     @default(false)
  featured        Boolean     @default(false)
  metaTitle       String?
  metaDescription String?
  status          StaffStatus @default(ACTIVE)
  products        Product[]
  createdAt       DateTime    @default(now())
}

model Brand {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String?     @unique
  description     String?
  logo            String?
  featured        Boolean     @default(false)
  metaTitle       String?
  metaDescription String?
  status          StaffStatus @default(ACTIVE)
  series          Series[]
  products        Product[]
  serviceJobs     ServiceJob[]
}

model Series {
  id       String      @id @default(cuid())
  name     String
  brandId  String
  brand    Brand       @relation(fields: [brandId], references: [id])
  status   StaffStatus @default(ACTIVE)
  products Product[]
}

model Unit {
  id        String      @id @default(cuid())
  name      String      @unique
  shortCode String
  status    StaffStatus @default(ACTIVE)
  products  Product[]
}

model Attribute {
  id         String           @id @default(cuid())
  name       String           @unique
  isOptional Boolean          @default(false)
  status     StaffStatus      @default(ACTIVE)
  values     AttributeValue[]
}

model AttributeValue {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  status      Boolean   @default(true)
}

model Product {
  id                 String                 @id @default(cuid())
  code               String?                @unique
  name               String
  slug               String                 @unique
  shortDescription   String?
  description        String?
  categoryId         String
  category           Category               @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  seriesId           String?
  series             Series?                @relation(fields: [seriesId], references: [id])
  unitId             String?
  unit               Unit?                  @relation(fields: [unitId], references: [id])
  regularPrice       Decimal
  salePrice          Decimal?
  costPrice          Decimal?
  buyingPrice        Decimal?
  wholesalePrice     Decimal?
  minOrderQty        Int                    @default(1)
  warranty           String?
  productType        String?                @default("Spare Parts")
  productCategory    String?                @default("SPARE_PART")
  condition          String?
  ogImageUrl         String?
  isNewest           Boolean                @default(false)
  isFeatured         Boolean                @default(false)
  isHomepage         Boolean                @default(false)
  isBestDeal         Boolean                @default(false)
  status             ProductStatus          @default(DRAFT)
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String?
  images             ProductImage[]
  variants           ProductVariant[]
  specifications     ProductSpecification[]
  orderItems         OrderItem[]
  wishlist           Wishlist[]
  reviews            Review[]
  wastedProducts     WastedProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  StockAdjustment    StockAdjustment[]
  serviceJobMaterials ServiceJobMaterial[]
  productRequestItems ProductRequestItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([categoryId, brandId, status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  color              String?
  quality            String?
  price              Decimal
  buyingPrice        Decimal?
  wholesalePrice     Decimal?
  discountedPrice    Decimal?
  offerPrice         Decimal?
  stock              Int                 @default(0)
  sku                String              @unique
  attributes         Json?
  branchInventories  BranchInventory[]
  phoneUnits         PhoneUnit[]
  orderItems         OrderItem[]
  stockAdjustments   StockAdjustment[]
  wastedProducts     WastedProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  productRequestItems ProductRequestItem[]

  @@index([productId])
  @@index([productId, sku])
}

model BranchInventory {
  id               String         @id @default(cuid())
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([branchId, productVariantId])
  @@index([branchId])
  @@index([productVariantId])
}

model PhoneUnit {
  id                String          @id @default(cuid())
  productVariantId  String
  productVariant    ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id])
  imei1             String          @unique
  imei2             String?         @unique
  serialNumber      String?
  status            PhoneUnitStatus @default(IN_STOCK)
  buyingPrice       Decimal?
  sellingPrice      Decimal?
  purchaseId        String?
  purchase          PurchaseOrder?  @relation(fields: [purchaseId], references: [id])
  saleId            String?
  sale              Order?          @relation(fields: [saleId], references: [id])
  orderItemId       String?
  orderItem         OrderItem?      @relation(fields: [orderItemId], references: [id])
  warrantyType      String?
  warrantyPeriod    String?
  warrantyStartDate DateTime?
  warrantyEndDate   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productVariantId])
  @@index([branchId])
  @@index([status])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
}

model WantedProduct {
  id            String   @id @default(cuid())
  productName   String
  customerName  String
  customerPhone String
  requestedDate DateTime @default(now())
  status        String   @default("NEW") // NEW SOURCING FULFILLED CANCELLED
  notes         String?
}

model WastedProduct {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  branchId     String?
  branch       Branch?         @relation(fields: [branchId], references: [id])
  quantity     Int
  reason       String // DAMAGED EXPIRED LOST DEFECTIVE
  note         String?
  costImpact   Decimal
  reportedById String
  reportedBy   Staff           @relation(fields: [reportedById], references: [id])
  createdAt    DateTime        @default(now())
}

// ============================= ORDERS / SALES =============================

model Order {
  id                String               @id @default(cuid())
  orderCode         String               @unique
  orderSeq          Int?                 @unique
  shortCode         String?
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id])
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id])
  saleType          SaleType             @default(WEBSITE)
  status            OrderStatus          @default(PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  paymentMethod     OrderPaymentMethod?
  subtotal          Decimal
  discountAmount    Decimal              @default(0)
  deliveryCharge    Decimal              @default(0)
  totalAmount       Decimal
  paidAmount        Decimal              @default(0)
  dueAmount         Decimal              @default(0)
  staffId           String?
  staff             Staff?               @relation(fields: [staffId], references: [id])
  shippingAddressId String?
  saleDate          DateTime             @default(now())
  shippingAddress   Address?             @relation(fields: [shippingAddressId], references: [id])
  needsStockReview  Boolean              @default(false)
  stockReviewNote   String?
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  notes             OrderNote[]
  serviceJob        ServiceJob?
  shipment          Shipment?
  salesReturn       SalesReturn?
  exchange          Exchange?
  supportTickets    SupportTicket[]
  paymentAttempts   PaymentAttempt[]
  payments          Payment[]
  phoneUnits        PhoneUnit[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@index([needsStockReview])
  @@index([shortCode])
  @@index([customerId, branchId, status, createdAt])
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?   @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal
  lineTotal           Decimal
  salesReturnItems    SalesReturnItem[]
  exchange            Exchange?         @relation("OldOrderItem")
  phoneUnits          PhoneUnit[]

  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   Staff?      @relation(fields: [changedById], references: [id])
  createdAt   DateTime    @default(now())
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  note      String
  createdAt DateTime @default(now())
}

model SalesReturn {
  id           String            @id @default(cuid())
  returnCode   String            @unique
  orderId      String            @unique
  order        Order             @relation(fields: [orderId], references: [id])
  branchId     String
  reason       String
  refundAmount Decimal
  status       ReturnStatus      @default(REQUESTED)
  items        SalesReturnItem[]
  createdAt    DateTime          @default(now())
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  salesReturnId String
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity      Int
}

model Exchange {
  id              String         @id @default(cuid())
  exchangeCode    String         @unique
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id])
  oldOrderItemId  String         @unique
  oldOrderItem    OrderItem      @relation("OldOrderItem", fields: [oldOrderItemId], references: [id])
  newProductId    String
  newVariantId    String?
  priceDifference Decimal
  status          ExchangeStatus @default(REQUESTED)
  createdAt       DateTime       @default(now())
}

model ServiceJob {
  id                    String               @id @default(cuid())
  invoiceNo             String?              @unique
  orderId               String?              @unique
  order                 Order?               @relation(fields: [orderId], references: [id])
  branchId              String?
  branch                Branch?              @relation(fields: [branchId], references: [id])
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id])
  customerName          String?
  customerPhone         String?
  referralNumber        String?
  technicianId          String?
  technician            Staff?               @relation(fields: [technicianId], references: [id])
  device                String
  deviceTypeId          String?
  deviceType            DeviceType?          @relation(fields: [deviceTypeId], references: [id])
  brandId               String?
  brand                 Brand?               @relation(fields: [brandId], references: [id])
  model                 String?
  issueDescription      String
  problems              Json?
  specialization        String?
  warrantyPeriod        String?
  warrantyStartDate     DateTime?
  warrantyEndDate       DateTime?
  laborCost             Decimal              @default(0)
  materialCost          Decimal              @default(0)
  totalBill             Decimal              @default(0)
  discount              Decimal              @default(0)
  finalAmount           Decimal              @default(0)
  paidAmount            Decimal              @default(0)
  dueAmount             Decimal              @default(0)
  serviceCharge         Decimal              @default(0)
  paymentDetails        Json?
  supplierId            String?
  supplier              Supplier?            @relation("ServiceJobSupplier", fields: [supplierId], references: [id])
  supplierPaymentStatus String?              // "Paid" | "Due" | "Pending"
  technicianProfitShare Decimal?             @default(0)
  materials             ServiceJobMaterial[]
  status                ServiceJobStatus     @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([technicianId])
  @@index([status])
  @@index([technicianId, status])
  @@index([branchId])
}

model DeviceType {
  id          String       @id @default(cuid())
  name        String       @unique
  status      StaffStatus  @default(ACTIVE)
  serviceJobs ServiceJob[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ServiceProblemType {
  id                  String      @id @default(cuid())
  name                String      @unique
  suggestedLaborPrice Decimal     @default(0)
  status              StaffStatus @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model ServiceWarrantyPeriod {
  id        String      @id @default(cuid())
  name      String      @unique
  days      Int         @default(0)
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ServiceJobMaterial {
  id           String                    @id @default(cuid())
  serviceJobId String
  serviceJob   ServiceJob                @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  partName     String
  productId    String?
  product      Product?                  @relation(fields: [productId], references: [id])
  sourceType   ServiceMaterialSourceType @default(OWN_STOCK)
  supplierId      String?
  supplier        Supplier?                 @relation(fields: [supplierId], references: [id])
  sourcedFromName String?
  sourceNote      String?
  cost         Decimal                   @default(0)
  quantity     Int                       @default(1)
  total        Decimal                   @default(0)
  createdAt    DateTime                  @default(now())
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  courierPartner String
  trackingNo     String         @unique
  status         ShipmentStatus @default(PENDING_PICKUP)
  address        String
  lastUpdated    DateTime       @updatedAt
}

model StockAdjustment {
  id             String              @id @default(cuid())
  referenceNo    String              @unique
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant?     @relation(fields: [variantId], references: [id])
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  type           StockAdjustmentType
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reason         String
  notes          String?
  adjustedById   String
  adjustedBy     Staff               @relation(fields: [adjustedById], references: [id])
  createdAt      DateTime            @default(now())
}

// ============================= HRM =============================

model Payroll {
  id            String              @id @default(cuid())
  staffId       String
  staff         Staff               @relation(fields: [staffId], references: [id])
  month         DateTime
  basicSalary   Decimal
  allowances    Json?
  deductions    Json?
  netSalary     Decimal
  status        PayrollStatus       @default(PENDING)
  paymentDate   DateTime?
  paymentMethod StaffPaymentMethod?
