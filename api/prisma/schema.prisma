// ============================= ACCOUNTING =============================

model WalletType {
  id               String              @id @default(cuid())
  name             String
  kind             WalletKind
  accountNumber    String?
  icon             String?
  isActive         Boolean             @default(true)
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  currentBalance   Decimal             @default(0)
  status           StaffStatus         @default(ACTIVE)
  transactions     WalletTransaction[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
}

enum PayrollLineType {
  SALARY
  ALLOWANCE
  BONUS
  OTHER
}

model WalletTransaction {
  id              String           @id @default(cuid())
  walletTypeId    String
  walletType      WalletType       @relation(fields: [walletTypeId], references: [id])
  type            WalletTxnType
  amount          Decimal
  purposeId       String?
  purpose         Purpose?         @relation(fields: [purposeId], references: [id])
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  transferGroupId String?
  referenceNo     String           @unique
  note            String?
  recordedById    String
  recordedBy      Staff            @relation("RecordedByStaff", fields: [recordedById], references: [id])
  staffId         String?
  staff           Staff?           @relation("StaffWalletTransactions", fields: [staffId], references: [id])
  payType         PayrollLineType?
  balanceAfter    Decimal
  createdAt       DateTime         @default(now())
}

model Purpose {
  id           String              @id @default(cuid())
  name         String              @unique
  category     PurposeCategory
  transactions WalletTransaction[]
}

model ExpenseCategory {
  id            String    @id @default(cuid())
  name          String    @unique
  icon          String?
  monthlyBudget Decimal?
  expenses      Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  referenceNo   String          @unique
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  description   String
  amount        Decimal
  walletTypeId  String
  walletType    WalletType      @relation(fields: [walletTypeId], references: [id])
  status        ExpenseStatus   @default(PENDING)
  attachmentUrl String?
  recordedById  String
  recordedBy    Staff           @relation(fields: [recordedById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([branchId])
  @@index([createdAt])
  @@index([branchId, createdAt])
}

model Supplier {
  id               String              @id @default(cuid())
  name             String
  companyName      String?
  logo             String?
  contactPerson    String
  phone            String
  email            String?
  address          String
  productsCategory String?
  productsSupplied String[]
  paymentTerms     SupplierPaymentTerm @default(COD)
  advanceBalance   Decimal             @default(0)
  totalDue         Decimal             @default(0)
  status           StaffStatus         @default(ACTIVE)
  payments         SupplierPayment[]
  purchaseOrders   PurchaseOrder[]
  serviceJobMaterials ServiceJobMaterial[]
  serviceJobs      ServiceJob[]        @relation("ServiceJobSupplier")
  createdAt        DateTime            @default(now())
}

model SupplierPayment {
  id              String         @id @default(cuid())
  referenceNo     String         @unique
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  amount          Decimal
  method          String
  walletTypeId    String
  walletType      WalletType     @relation(fields: [walletTypeId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  note            String?
  recordedById    String
  recordedBy      Staff          @relation(fields: [recordedById], references: [id])
  createdAt       DateTime       @default(now())
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  poSeq                Int?                @unique
  shortCode            String?
  invoiceNumber        String?
  documentUrl          String?
  internalNotes        String?
  branchId             String
  branch               Branch              @relation(fields: [branchId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal
  discount             Decimal             @default(0)
  shippingCost         Decimal             @default(0)
  tax                  Decimal             @default(0)
  grandTotal           Decimal
  amountPaid           Decimal             @default(0)
  advanceUsed          Decimal             @default(0)
  dueAmount            Decimal             @default(0)
  items                PurchaseOrderItem[]
  payments             SupplierPayment[]
  phoneUnits           PhoneUnit[]
  createdAt            DateTime            @default(now())

  @@index([shortCode])
}

model PurchaseOrderItem {
  id               String          @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int             @default(0)
  unitCost         Decimal
  sellingPrice     Decimal?
  wholesalePrice   Decimal?
  offerPrice       Decimal?
  lineTotal        Decimal
}

