# ==============================================================================
# MobileHubBD Frontend Environment Variables (Set in Vercel Project Settings)
# ==============================================================================

# Public URL of the backend REST API (Render / Railway)
NEXT_PUBLIC_API_URL=https://mobilehubbd-api.onrender.com/api/v1

# Base URL of the backend server (Render / Railway)
NEXT_PUBLIC_BACKEND_URL=https://mobilehubbd-api.onrender.com

# Public Storefront Site URL (used for canonical URLs, metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://mobilehubbd.tech

# Optional: On-demand ISR cache revalidation secret token
REVALIDATION_SECRET=generate-a-secure-revalidation-secret-token
