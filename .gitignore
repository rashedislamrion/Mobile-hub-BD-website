# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and subpackages)
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage/
coverage/

# next.js & nestjs builds
/.next/
.next/
/out/
out/
/build/
build/
dist/
**/dist/

# misc & OS
.DS_Store
*.pem
*.key

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# environment & secret files
.env
.env.*
api/.env
api/.env.*
!.env.example
!.env.*.example
!api/.env.example
!api/.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# upload roots (anchored to root and api/ to avoid ignoring real source folders like api/src/**/uploads)
/uploads/
/private-uploads/
/api/uploads/
/api/private-uploads/

# backups, archives, dumps & scratch
/backups/
*.dump
*.tar.gz
scratch/
.system_generated/
local_db_backup_*
*.sql
!api/prisma/migrations/**/*.sql

# root screenshots and stray images
/*.png
/*.jpg
/*.jpeg
WhatsApp Image*
Screenshot*

# legacy verification scripts containing demo credentials
/scripts/verify-*.mjs
/api/test/auth.e2e-spec.ts
/docs/archive/MOCK_DATA_AUDIT.md
/docs/archive/PROJECT_ANALYZE.md
/docs/archive/PROJECT_ANALYZE_3.md
/docs/archive/PROJECT_FULL_ANALYSIS_REPORT.md
/docs/archive/QA_AUDIT_REPORT.md

