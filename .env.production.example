# ==============================================================================
# MobileHubBD Storefront & Admin Frontend (Next.js) — Production Environment
# Target: Single VPS (Ubuntu 22.04/24.04), Next.js server on port 3000 behind Nginx
# ==============================================================================
#
# IMPORTANT BUILD NOTE:
# Variables prefixed with NEXT_PUBLIC_* are inlined into the client-side JavaScript
# bundle at BUILD TIME (`npm run build`). If you modify any NEXT_PUBLIC_* variable,
# you MUST rebuild the application (`npm run build`) before restarting the process.
# ==============================================================================

# [REQUIRED] REST API Base URL with version prefix (used by client-side browser requests)
# Example: https://api.mobilehubbd.tech/api/v1 (or https://mobilehubbd.tech/api/v1)
# Note: No trailing slash!
NEXT_PUBLIC_API_URL=https://api.mobilehubbd.tech/api/v1

# [REQUIRED] Backend Server Root URL (used for resolving /uploads/... images)
# Note: No trailing slash!
NEXT_PUBLIC_BACKEND_URL=https://api.mobilehubbd.tech

# [REQUIRED] Internal Server-to-Server Backend URL (Used for fast SSR loopback without public hairpinning)
INTERNAL_BACKEND_URL=http://localhost:4000

# [REQUIRED] Public Storefront Site URL (used for canonical URLs, metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://mobilehubbd.tech

# [REQUIRED] On-demand ISR cache revalidation secret
# MUST be identical to backend REVALIDATION_SECRET.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY

# [OPTIONAL] Brand & Store Name display fallbacks (defaults to MobileHubBD if unset)
NEXT_PUBLIC_STORE_NAME=MobileHubBD
NEXT_PUBLIC_SITE_NAME=MobileHubBD

# [OPTIONAL] Cloudflare R2 Public URL (if using external S3/R2 CDN for image uploads)
NEXT_PUBLIC_R2_PUBLIC_URL=

# [REQUIRED] Node runtime environment
NODE_ENV=production

# [OPTIONAL] Listening port for Next.js production server (default: 3000)
PORT=3000
